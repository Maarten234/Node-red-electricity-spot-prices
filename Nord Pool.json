    {
        "id": "a09c4a14fd7c1959",
        "type": "function",
        "z": "34d2b246049c07ac",
        "g": "6ab38a1f3f297bf9",
        "name": "Analyze today Prices",
        "func": "let sorted=msg.prices.map(entry => ({deliveryStart: entry.deliveryStart,\n                                  deliveryEnd: entry.deliveryEnd,\n                                  price: entry.entryPerArea[msg.country]\n                                })).sort((a, b) => a.price - b.price);\nmsg.cheapestHour=sorted[0];\nmsg.expensiveHours=sorted.slice(-msg.datapointsperday/2).sort((a, b) => new Date(a.deliveryStart) - new Date(b.deliveryStart));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1580,
        "y": 1600,
        "wires": [
            [
                "1e3a8816bf1b5a1f"
            ]
        ]
    },
    {
        "id": "10c83364be03eabb",
        "type": "function",
        "z": "34d2b246049c07ac",
        "g": "6ab38a1f3f297bf9",
        "name": "Merge tomorrow prices",
        "func": "msg.prices=msg.prices||global.get('energyprices').slice(-msg.datapointsperday);\nmsg.prices = [...msg.prices, ...msg.payload.multiIndexEntries];\n\nlet d=new Date();\nnode.status({text:d.toISOString().split('T')[0]+\" \"+d.toTimeString().split(\" \")[0]});\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1530,
        "y": 1340,
